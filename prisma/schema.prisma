// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =======================
// ENUMS
// =======================

enum Species {
  DOG
  CAT
}

enum Sex {
  MALE
  FEMALE
}

enum UserRole {
  ADMIN
  VETERINARIAN
  CLIENT
}

enum RecordType {
  PET
  GROUP
}

enum MedicationCategory {
  VACCINE
  ANTIBIOTIC
  OTHER
}

enum InventoryCategory {
  MEDICATION
  MATERIAL
}

// =======================
// MODELS
// =======================

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          UserRole
  clientId      String?   @unique
  isActive      Boolean   @default(true)
  banned        Boolean   @default(false)
  banReason     String?
  banExpires    DateTime?

  client       Client?       @relation(fields: [clientId], references: [id])
  visits       Visit[]       @relation("VeterinarianVisits")
  vaccinations Vaccination[]
  sessions     Session[]
  accounts     Account[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id             String   @id @default(uuid())
  expiresAt      DateTime
  token          String   @unique
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
}

model Client {
  id        String  @id @default(uuid())
  name      String
  phone     String
  address   String?
  latitude  Float?
  longitude Float?
  notes     String?
  isActive  Boolean @default(true)

  user           User?           @relation
  medicalRecords MedicalRecord[]
  visits         Visit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MedicalRecord {
  id       String     @id @default(uuid())
  type     RecordType
  name     String
  notes    String?
  isActive Boolean    @default(true)

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  pet           Pet?
  animalGroup   AnimalGroup?
  consultations Consultation[]
  vaccinations  Vaccination[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Pet {
  id        String    @id @default(uuid())
  species   Species
  sex       Sex?
  breed     String?
  birthDate DateTime?
  color     String?
  notes     String?

  recordId String        @unique
  record   MedicalRecord @relation(fields: [recordId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AnimalGroup {
  id         String  @id @default(uuid())
  animalType String
  quantity   Int
  notes      String?

  recordId String        @unique
  record   MedicalRecord @relation(fields: [recordId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Visit {
  id           String   @id @default(uuid())
  date         DateTime
  generalNotes String?

  clientId       String
  client         Client @relation(fields: [clientId], references: [id])
  veterinarianId String
  veterinarian   User   @relation("VeterinarianVisits", fields: [veterinarianId], references: [id])

  consultations Consultation[]

  createdAt DateTime @default(now())
}

model Consultation {
  id        String  @id @default(uuid())
  reason    String?
  diagnosis String?
  treatment String?
  notes     String?

  visitId  String
  visit    Visit         @relation(fields: [visitId], references: [id])
  recordId String
  record   MedicalRecord @relation(fields: [recordId], references: [id])

  vaccinations Vaccination[]

  createdAt DateTime @default(now())
}

model Medication {
  id                  String             @id @default(uuid())
  name                String
  category            MedicationCategory
  species             Species?
  defaultIntervalDays Int?
  notes               String?
  isActive            Boolean            @default(true)

  vaccinations   Vaccination[]
  inventoryItems InventoryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vaccination {
  id          String    @id @default(uuid())
  appliedAt   DateTime
  nextDueDate DateTime?

  medicationId   String
  medication     Medication    @relation(fields: [medicationId], references: [id])
  recordId       String
  record         MedicalRecord @relation(fields: [recordId], references: [id])
  consultationId String?
  consultation   Consultation? @relation(fields: [consultationId], references: [id])
  veterinarianId String
  veterinarian   User          @relation(fields: [veterinarianId], references: [id])

  createdAt DateTime @default(now())
}

model InventoryItem {
  id             String            @id @default(uuid())
  name           String
  category       InventoryCategory
  unit           String
  quantity       Int
  expirationDate DateTime?
  medicationId   String?
  isActive       Boolean           @default(true)

  medication Medication? @relation(fields: [medicationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
