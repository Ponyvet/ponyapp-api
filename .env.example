# Base de datos PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ponydb"

# Puerto en que escucha el servidor (default: 3000)
PORT=3000

# Secreto para firmar JWTs (genera uno con: openssl rand -hex 64)
JWT_SECRET="cambia_este_valor_por_uno_seguro"

# Datos del usuario admin inicial. Si no existe ningún ADMIN al arrancar
# la app, se crea automáticamente con estos valores (ver src/plugins/bootstrap-admin.ts).
# Si falta alguna de las tres, se omite la creación.
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_EMAIL="admin@ponyvet.com"
SEED_ADMIN_PASSWORD="cambia_este_valor_por_uno_seguro"
