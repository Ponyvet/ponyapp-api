meta {
  name: Create consultation
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/consultations
  body: json
  auth: none
}

body:json {
  {
    "recordId": "record-id-example",
    "date": "2026-01-31T10:00:00.000Z",
    "reason": "Control rutinario",
    "diagnosis": "Animal saludable",
    "treatment": "Ninguno requerido",
    "notes": "Control preventivo",
    "veterinarianId": "vet-id-example"
  }
}

tests {
  test("Should return 401 without token", function() {
    expect(res.getStatus()).to.equal(401);
  });

  test("Should return success with valid token", function() {
    expect(res.getStatus()).to.be.oneOf([200, 201]);
  });
}