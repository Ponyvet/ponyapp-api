meta {
  name: Create medical record
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/medical-records
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "type": "PET",
    "name": "Max",
    "notes": "Golden Retriever, muy activo",
    "clientId": "client-id-example"
  }
}

tests {
  test("Should return 401 without token", function() {
    expect(res.getStatus()).to.equal(401);
  });

  test("Should return success with valid token", function() {
    expect(res.getStatus()).to.be.oneOf([200, 201]);
  });
}