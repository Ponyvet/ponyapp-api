meta {
  name: Update medical record
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/medical-records/record-id-example
  body: json
  auth: none
}

body:json {
  {
    "type": "PET",
    "name": "Max Updated",
    "notes": "Golden Retriever, actualizado",
    "clientId": "client-id-example"
  }
}

tests {
  test("Should return 401 without token", function() {
    expect(res.getStatus()).to.equal(401);
  });

  test("Should return success with valid token", function() {
    expect(res.getStatus()).to.be.oneOf([200, 201]);
  });
}