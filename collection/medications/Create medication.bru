meta {
  name: Create medication
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/medications
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Vacuna Triple Felina",
    "category": "VACCINE",
    "species": "CAT",
    "defaultIntervalDays": 365,
    "notes": "Vacuna anual para felinos"
  }
}

tests {
  test("Should return 401 without token", function() {
    expect(res.getStatus()).to.equal(401);
  });

  test("Should return success with valid token", function() {
    expect(res.getStatus()).to.be.oneOf([200, 201]);
  });
}