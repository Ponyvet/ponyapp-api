meta {
  name: Update medication
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/medications/medication-id-example
  body: json
  auth: none
}

body:json {
  {
    "name": "Vacuna Triple Felina Actualizada",
    "category": "VACCINE",
    "species": "CAT",
    "defaultIntervalDays": 365,
    "notes": "Vacuna anual para felinos - actualizada"
  }
}

tests {
  test("Should return 401 without token", function() {
    expect(res.getStatus()).to.equal(401);
  });

  test("Should return success with valid token", function() {
    expect(res.getStatus()).to.be.oneOf([200, 201]);
  });
}