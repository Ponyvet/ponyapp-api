meta {
  name: Get session
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/auth/get-session
  body: none
  auth: inherit
}

tests {
  test("Should return the current session and user", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.property("user");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
