meta {
  name: Adjust inventory quantity
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/inventory/inventory-id-example/adjust
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "quantity": -10,
    "reason": "Uso en consulta"
  }
}

tests {
  test("Should return 401 without token", function() {
    expect(res.getStatus()).to.equal(401);
  });

  test("Should return success with valid token", function() {
    expect(res.getStatus()).to.be.oneOf([200, 201]);
  });
}