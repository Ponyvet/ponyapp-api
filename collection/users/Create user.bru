meta {
  name: Create user
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/users
  body: json
  auth: none
}

body:json {
  {
    "name": "Vladimir Azpeitia",
    "email": "vazpeitiah@gmail.com",
    "password": "12345678",
    "role": "ADMIN",
    "clientId": null
  }
}

tests {
  test("Should return 401 without token", function() {
    expect(res.getStatus()).to.equal(401);
  });

  test("Should return success with valid token", function() {
    expect(res.getStatus()).to.be.oneOf([200, 201]);
  });
}