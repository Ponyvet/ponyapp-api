meta {
  name: Create user
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/users/register
  body: json
  auth: none
}

script:pre-request {
  // Bruno's npm module resolver doesn't honor faker's "require" export condition,
  // so it loads the ESM build and crashes; requiring the .cjs file directly avoids that path.
  const { fakerES_MX: faker } = require(`${bru.cwd()}/node_modules/@faker-js/faker/dist/index.cjs`)

  const firstName = faker.person.firstName()
  const lastName = faker.person.lastName()

  bru.setVar("randomUserName", `${firstName} ${lastName}`)
  bru.setVar("randomUserEmail", faker.internet.email({ firstName, lastName }))
  bru.setVar("randomUserRole", faker.helpers.arrayElement(["ADMIN", "VETERINARIAN"]))
}

body:json {
  {
    "name": "{{randomUserName}}",
    "email": "{{randomUserEmail}}",
    "password": "12345678",
    "role": "{{randomUserRole}}",
    "clientId": null
  }
}

tests {
  test("Should return 401 without token", function() {
    expect(res.getStatus()).to.equal(401);
  });

  test("Should return success with valid token", function() {
    expect(res.getStatus()).to.be.oneOf([200, 201]);
  });
}