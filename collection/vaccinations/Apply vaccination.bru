meta {
  name: Apply vaccination
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/vaccinations
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "appliedAt": "2026-01-31T10:00:00.000Z",
    "nextDueDate": "2026-02-28T10:00:00.000Z",
    "medicationId": "medication-id-example",
    "recordId": "record-id-example",
    "consultationId": null,
    "veterinarianId": "vet-id-example"
  }
}

tests {
  test("Should return 401 without token", function() {
    expect(res.getStatus()).to.equal(401);
  });

  test("Should return success with valid token", function() {
    expect(res.getStatus()).to.be.oneOf([200, 201]);
  });
}